# Port for the Node.js HTTP server
PORT=3000

# Discord Bot Token (keep secret, never commit)
DISCORD_BOT_TOKEN=

# Discord Server (Guild) ID (17-20 digits)
DISCORD_GUILD_ID=

# Shared secret used by Google Apps Script to authenticate requests (generate a long random string)
DISCORD_BRIDGE_SECRET=

# Optional: Bot User ID (auto-fetched from Discord /users/@me if omitted)
DISCORD_BOT_ID=

# Optional: Discord API base URL, timeout (ms), and max request body size (bytes)
DISCORD_API_BASE=https://discord.com/api/v10
REQUEST_TIMEOUT_MS=15000
MAX_BODY_BYTES=262144
